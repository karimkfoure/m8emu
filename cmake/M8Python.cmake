# Translation dependencies are host tools, including during a cross build.
include_guard(GLOBAL)
function(m8emu_check_python interpreter result)
    execute_process(COMMAND "${interpreter}" -c
        "import capstone,sys;sys.exit(0 if capstone.__version__ == '5.0.7' else 1)"
        RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET TIMEOUT 30)
    if(status EQUAL 0)
        set(${result} TRUE PARENT_SCOPE)
    else()
        set(${result} FALSE PARENT_SCOPE)
    endif()
endfunction()

function(m8emu_prepare_python)
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    if(M8_AOT_PYTHON)
        m8emu_check_python("${M8_AOT_PYTHON}" valid)
        if(NOT valid)
            message(FATAL_ERROR "M8_AOT_PYTHON must import capstone==5.0.7: ${M8_AOT_PYTHON}")
        endif()
        set(interpreter "${M8_AOT_PYTHON}")
    else()
        m8emu_check_python("${Python3_EXECUTABLE}" valid)
        if(valid)
            set(interpreter "${Python3_EXECUTABLE}")
        else()
            set(venv "${CMAKE_BINARY_DIR}/tools/python")
            set(interpreter "${venv}/bin/python")
            m8emu_check_python("${interpreter}" ready)
            if(NOT ready)
                execute_process(COMMAND "${Python3_EXECUTABLE}" -m venv "${venv}"
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
                if(NOT status EQUAL 0)
                    find_program(m8_uv NAMES uv)
                    if(NOT m8_uv)
                        message(FATAL_ERROR "Cannot create translation venv; install Python venv support or uv: ${output}${error}")
                    endif()
                    execute_process(COMMAND "${m8_uv}" venv --no-python-downloads
                        --allow-existing --python "${Python3_EXECUTABLE}" "${venv}"
                        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 120)
                    if(NOT status EQUAL 0)
                        message(FATAL_ERROR "Cannot create translation venv with uv: ${output}${error}")
                    endif()
                    set(install "${m8_uv}" pip install --no-python-downloads --python "${interpreter}")
                else()
                    set(install "${interpreter}" -m pip install
                        --disable-pip-version-check --no-input --timeout 45 --retries 2)
                endif()
                execute_process(COMMAND ${install} "capstone==5.0.7"
                    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 300)
                if(NOT status EQUAL 0)
                    message(FATAL_ERROR "Cannot install pinned capstone==5.0.7: ${output}${error}")
                endif()
                m8emu_check_python("${interpreter}" ready)
                if(NOT ready)
                    message(FATAL_ERROR "Translation venv cannot import capstone==5.0.7 after installation")
                endif()
            endif()
        endif()
        set(M8_AOT_PYTHON "${interpreter}" CACHE FILEPATH "Pinned host translation interpreter" FORCE)
    endif()
    if(M8_NATIVE_PYTHON)
        m8emu_check_python("${M8_NATIVE_PYTHON}" valid)
        if(NOT valid)
            message(FATAL_ERROR "M8_NATIVE_PYTHON must import capstone==5.0.7: ${M8_NATIVE_PYTHON}")
        endif()
    else()
        set(M8_NATIVE_PYTHON "${interpreter}" CACHE FILEPATH "Pinned host native-region interpreter" FORCE)
    endif()
    set(M8_AOT_PYTHON "${interpreter}" PARENT_SCOPE)
    set(M8_NATIVE_PYTHON "${M8_NATIVE_PYTHON}" PARENT_SCOPE)
endfunction()
