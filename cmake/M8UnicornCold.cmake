# Optional whole-source size experiment. The list must come from measured
# profiles of the complete ARM engine. An empty path leaves every flag intact.
set(M8_UNICORN_COLD_SOURCES_FILE "" CACHE FILEPATH "Profile-selected Unicorn C sources, relative to its source directory")
set(M8_UNICORN_COLD_OPT_LEVEL Os CACHE STRING "Optimization for profile-selected cold Unicorn sources")
set_property(CACHE M8_UNICORN_COLD_OPT_LEVEL PROPERTY STRINGS Os O2)

function(m8_unicorn_cold_sources)
    if(NOT M8_UNICORN_COLD_SOURCES_FILE)
        return()
    endif()
    if(NOT CMAKE_C_COMPILER_ID MATCHES "GNU|Clang")
        message(FATAL_ERROR "M8_UNICORN_COLD_SOURCES_FILE requires GCC or Clang")
    endif()
    if(NOT M8_UNICORN_COLD_OPT_LEVEL MATCHES "^(Os|O2)$")
        message(FATAL_ERROR "M8_UNICORN_COLD_OPT_LEVEL must be Os or O2")
    endif()
    if(NOT EXISTS "${M8_UNICORN_COLD_SOURCES_FILE}")
        message(FATAL_ERROR "Cold-source list does not exist: ${M8_UNICORN_COLD_SOURCES_FILE}")
    endif()
    if(NOT TARGET unicorn)
        message(FATAL_ERROR "Call m8_unicorn_cold_sources after creating the Unicorn targets")
    endif()
    get_target_property(source_root unicorn SOURCE_DIR)
    file(STRINGS "${M8_UNICORN_COLD_SOURCES_FILE}" list_lines)
    set(selected "")
    foreach(line IN LISTS list_lines)
        string(STRIP "${line}" source)
        if(source STREQUAL "" OR source MATCHES "^#")
            continue()
        endif()
        if(NOT source MATCHES "^[A-Za-z0-9_./+-]+[.]c$" OR
                source MATCHES "^/|(^|/)[.][.](/|$)")
            message(FATAL_ERROR "Invalid cold-source path: '${source}'; expected a relative Unicorn C source")
        endif()
        file(REAL_PATH "${source_root}/${source}" full_source)
        if(NOT EXISTS "${full_source}")
            message(FATAL_ERROR "Cold source does not exist: '${source}' under '${source_root}'")
        endif()
        if(full_source IN_LIST selected)
            message(FATAL_ERROR "Duplicate cold source: '${source}'")
        endif()
        list(APPEND selected "${full_source}")
    endforeach()
    if(NOT selected)
        message(FATAL_ERROR "Cold-source list has no C sources: ${M8_UNICORN_COLD_SOURCES_FILE}")
    endif()
    set(matched "")
    foreach(target unicorn unicorn_static unicorn-common arm-softmmu)
        if(NOT TARGET ${target})
            continue()
        endif()
        get_target_property(target_sources ${target} SOURCES)
        get_target_property(target_root ${target} SOURCE_DIR)
        foreach(source IN LISTS target_sources)
            if(source MATCHES "^[$]<")
                continue()
            endif()
            file(REAL_PATH "${source}" full_source BASE_DIRECTORY "${target_root}")
            if(full_source IN_LIST selected)
                # Source options follow target options on GCC/Clang commands.
                # Apply in the target's directory because Unicorn is a subdir.
                if(NOT full_source IN_LIST matched)
                    set_property(SOURCE "${full_source}" TARGET_DIRECTORY ${target}
                        APPEND PROPERTY COMPILE_OPTIONS "-${M8_UNICORN_COLD_OPT_LEVEL}")
                    list(APPEND matched "${full_source}")
                endif()
            endif()
        endforeach()
    endforeach()
    foreach(source IN LISTS selected)
        if(NOT source IN_LIST matched)
            message(FATAL_ERROR "Cold source is not in an enabled Unicorn target: '${source}'")
        endif()
    endforeach()
    list(LENGTH matched source_count)
    message(STATUS "Unicorn cold sources: ${source_count} at -${M8_UNICORN_COLD_OPT_LEVEL}; all other source flags unchanged")
endfunction()
