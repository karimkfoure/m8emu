# Public build-time PGO. The outer build contains only the orchestration target.
include_guard(GLOBAL)
set(M8_PGO OFF CACHE STRING "Build-time GCC PGO (OFF or AUTO)")
set_property(CACHE M8_PGO PROPERTY STRINGS OFF AUTO)
set(M8_PGO_PHASE NONE CACHE STRING "Internal library phase (NONE, GENERATE or USE)")
set_property(CACHE M8_PGO_PHASE PROPERTY STRINGS NONE GENERATE USE)
set(M8_PGO_PROFILE_DIR "${CMAKE_BINARY_DIR}/profiles" CACHE PATH "Internal GCC profile directory")
set(M8_PGO_TRAINING_SECONDS 2 CACHE STRING "Audio seconds per synthetic training project")
set(M8_PGO_JOBS 2 CACHE STRING "Maximum simultaneous generated-code compiles")
set(M8_PGO_TRAIN_JOBS 1 CACHE STRING "Maximum simultaneous isolated PGO training cases")
set(M8_PGO_TIMEOUT 3600 CACHE STRING "Deadline for each build or training command")
set(M8_PGO_FIXTURES "" CACHE STRING "Optional synthetic training fixture subset")

function(m8_pgo_orchestrate result)
    if(NOT M8_PGO MATCHES "^(OFF|AUTO)$" OR NOT M8_PGO_PHASE MATCHES "^(NONE|GENERATE|USE)$")
        message(FATAL_ERROR "M8_PGO requires OFF/AUTO; M8_PGO_PHASE requires NONE/GENERATE/USE")
    endif()
    set(${result} FALSE PARENT_SCOPE)
    if(NOT M8_PGO STREQUAL "AUTO")
        return()
    endif()
    if(NOT M8_PGO_PHASE STREQUAL "NONE")
        message(FATAL_ERROR "The outer AUTO build cannot select a library phase")
    endif()
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "Build-time PGO requires GCC. Use linux-dev for other compilers.")
    endif()
    find_package(Python3 3.9 REQUIRED COMPONENTS Interpreter)
    get_cmake_property(cache_variables CACHE_VARIABLES)
    set(forward "# Effective public configure inputs.\n")
    foreach(name IN LISTS cache_variables)
        if(name MATCHES "^(M8_|SDL|CMAKE_(C_COMPILER|CXX_COMPILER|AR|RANLIB|TOOLCHAIN_FILE|PREFIX_PATH|FIND_ROOT_PATH|SYSROOT|BUILD_TYPE|CROSSCOMPILING_EMULATOR|C_FLAGS|EXE_LINKER_FLAGS|SHARED_LINKER_FLAGS))" AND
           NOT name MATCHES "^(M8_PGO_PHASE|M8_PGO_PROFILE_DIR)$" AND
           NOT name MATCHES "(_BINARY_DIR|_SOURCE_DIR|_FOUND|_DIR)$")
            get_property(type CACHE "${name}" PROPERTY TYPE)
            if(type STREQUAL "INTERNAL" OR type STREQUAL "STATIC")
                continue()
            endif()
            string(APPEND forward "set(${name} [==[${${name}}]==] CACHE ${type} \"Forwarded public configure input\" FORCE)\n")
        endif()
    endforeach()
    # CMAKE_PREFIX_PATH and SDL3_DIR can intentionally point at a user's package.
    foreach(name IN ITEMS SDL3_DIR M8_SDL_SOURCE)
        if(DEFINED ${name})
            string(APPEND forward "set(${name} [==[${${name}}]==] CACHE PATH \"Forwarded package override\" FORCE)\n")
        endif()
    endforeach()
    file(WRITE "${CMAKE_BINARY_DIR}/pgo-forward.cmake" "${forward}")
    add_custom_target(m8emu ALL
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_SOURCE_DIR}/pgo/build.py"
            --source "${CMAKE_SOURCE_DIR}" --build "${CMAKE_BINARY_DIR}"
            --cmake "${CMAKE_COMMAND}" --generator "${CMAKE_GENERATOR}"
            --cache "${CMAKE_BINARY_DIR}/pgo-forward.cmake"
            --jobs "${M8_PGO_JOBS}" --train-jobs "${M8_PGO_TRAIN_JOBS}" --timeout "${M8_PGO_TIMEOUT}"
        USES_TERMINAL VERBATIM)
    set(${result} TRUE PARENT_SCOPE)
endfunction()

function(m8_pgo_register_target target)
    if(M8_PGO_PHASE STREQUAL "NONE")
        return()
    endif()
    if(NOT CMAKE_C_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "Generated-library PGO requires GCC")
    endif()
    target_compile_options(${target} PRIVATE "-fprofile-prefix-path=${CMAKE_BINARY_DIR}")
    if(M8_PGO_PHASE STREQUAL "GENERATE")
        target_compile_options(${target} PRIVATE "-fprofile-generate=${M8_PGO_PROFILE_DIR}"
            -fprofile-update=atomic -ftest-coverage)
        target_link_options(${target} PRIVATE "-fprofile-generate=${M8_PGO_PROFILE_DIR}")
    else()
        target_compile_options(${target} PRIVATE "-fprofile-use=${M8_PGO_PROFILE_DIR}"
            -Werror=missing-profile -Werror=coverage-mismatch)
        target_link_options(${target} PRIVATE "-fprofile-use=${M8_PGO_PROFILE_DIR}")
    endif()
    if(target STREQUAL "m8native-regions" AND M8_NATIVE_CORPUS_CATALOG)
        # The qualified split profiles hot.c only. Cold and wrapper objects
        # retain their existing O2 recipe in both phases.
        get_target_property(region_sources ${target} SOURCES)
        foreach(source IN LISTS region_sources)
            get_filename_component(name "${source}" NAME)
            if(NOT name STREQUAL "hot.c")
                if(M8_PGO_PHASE STREQUAL "GENERATE")
                    set_property(SOURCE "${source}" TARGET_DIRECTORY ${target}
                        APPEND PROPERTY COMPILE_OPTIONS -fno-profile-generate -fno-test-coverage)
                else()
                    set_property(SOURCE "${source}" TARGET_DIRECTORY ${target}
                        APPEND PROPERTY COMPILE_OPTIONS -fno-profile-use)
                endif()
            endif()
        endforeach()
    endif()

endfunction()

function(m8_pgo_finalize)
    cmake_parse_arguments(PGO "" "TARGET" "" ${ARGN})
    if(NOT M8_NATIVE_ENGINE OR NOT M8_NATIVE_REGIONS OR NOT M8_BUILD_AOT)
        return()
    endif()
    add_executable(m8-pgo-runner "${CMAKE_SOURCE_DIR}/pgo/train.c")
    target_link_libraries(m8-pgo-runner PRIVATE m8rt ${CMAKE_DL_LIBS} m)
    target_include_directories(m8-pgo-runner PRIVATE
        "${CMAKE_SOURCE_DIR}/core/include/m8emu" "${CMAKE_SOURCE_DIR}/core/engine"
        "${CMAKE_SOURCE_DIR}/core/machine" "${CMAKE_SOURCE_DIR}/aot")
    target_compile_definitions(m8-pgo-runner PRIVATE M8RT_NATIVE_ENGINE)
    set_target_properties(m8-pgo-runner PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
    add_dependencies(m8-pgo-runner m8aot m8native-regions m8native-step)
    if(TARGET m8emu-firmware)
        add_dependencies(m8-pgo-runner m8emu-firmware)
    endif()
    foreach(target IN ITEMS m8aot m8native-regions m8native-step)
        m8_pgo_register_target(${target})
    endforeach()
    if(TARGET SDL3::SDL3)
        set(m8_pgo_sdl "$<TARGET_FILE:SDL3::SDL3>")
    elseif(TARGET SDL3-shared)
        set(m8_pgo_sdl "$<TARGET_FILE:SDL3-shared>")
    else()
        message(FATAL_ERROR "Native PGO packaging needs the SDL3 shared target")
    endif()
    file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/pgo-targets.json" CONTENT
"{\n  \"runner\": \"$<TARGET_FILE:m8-pgo-runner>\",\n  \"app\": \"$<TARGET_FILE:${PGO_TARGET}>\",\n  \"runtime\": \"$<TARGET_FILE:m8rt>\",\n  \"aot\": \"$<TARGET_FILE:m8aot>\",\n  \"regions\": \"$<TARGET_FILE:m8native-regions>\",\n  \"handlers\": \"$<TARGET_FILE:m8native-step>\",\n  \"unicorn\": \"$<TARGET_FILE:unicorn>\",\n  \"sdl\": \"${m8_pgo_sdl}\",\n  \"firmware\": \"${M8_FIRMWARE_BIN}\",\n  \"compiler\": \"${CMAKE_C_COMPILER}\",\n  \"compiler_version\": \"${CMAKE_C_COMPILER_VERSION}\",\n  \"cross\": \"${CMAKE_CROSSCOMPILING}\",\n  \"emulator\": \"${CMAKE_CROSSCOMPILING_EMULATOR}\"\n}\n")
endfunction()
